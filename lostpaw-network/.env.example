# npm run dev always uses the development disk store without contacting MongoDB.
NODE_ENV=development
DATASTORE_ADAPTER=disk
PORT=1337
HOST=127.0.0.1
LOCAL_DATA_DIR=.data/database
UPLOAD_DIR=.data/uploads
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional in development (a temporary secret is generated if unset).
# Set at least 32 random bytes in production to keep sessions valid across restarts.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Production requires DATASTORE_ADAPTER=mongo and a working MongoDB URL.
# MONGODB_URI=mongodb://127.0.0.1:27017/lostpawnetwork
# Set FRONTEND_ORIGINS to your exact HTTPS frontend origins in production.
# Production requests require HTTPS (except /health for internal health checks).
# When TLS terminates at a reverse proxy, trust only that proxy's addresses:
# TRUST_PROXY_IPS=127.0.0.1,::1
# Configure the proxy to overwrite X-Forwarded-For and X-Forwarded-Proto, and
# block direct public access to the backend port. Never trust arbitrary proxies.
